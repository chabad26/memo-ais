    {
      "id": 11,
      "title": "Historique des contrôles HTTP",
      "description": "Observer 1 → 0 → 1. Une interruption de collecte doit rester un trou, pas être remplacée par zéro.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
