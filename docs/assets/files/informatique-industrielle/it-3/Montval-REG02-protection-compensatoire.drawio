width="1060" height="300" /></mxCell><mxCell id="regzone" value="REG-02 — ISOLÉ&#10;GW-02 seul en réseau" style="rounded=1;html=0;whiteSpace=wrap;align=left;spacing=12;verticalAlign=top;fillColor=#f2f5f8;strokeColor=#38718a;fontColor=#18354c;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="560" y="880" width="1060" height="210" /></mxCell><mxCell id="maint" value="MAINT-01&#10;Session externe autorisée" style="rounded=1;html=0;whiteSpace=wrap;align=left;spacing=12;verticalAlign=top;fillColor=#edf6f3;strokeColor=#38718a;fontColor=#18354c;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="210" width="330" height="85" /></mxCell><mxCell id="bast" value="Point d’accès / BASTION&#10;Identité, autorisation et traces&#10;Pas de connexion directe REG-02" style="rounded=1;html=0;whiteSpace=wrap;align=left;spacing=12;verticalAlign=top;fillColor=#fff3df;strokeColor=#38718a;fontColor=#18354c;fontSize=16;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="495" width="330" height="100" /></mxCell><mxCell id="sup" value="SUP-01&#10;Lecture des mesures et alarmes" style="rounded=1;html=0;whiteSpace=wrap;align=left;spacing=12;verticalAlign=top;fillColor=#edf6f3;strokeColor=#38718a;fontColor=#18354c;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="600" y="210" width="350" height="85" /></mxCell><mxCell id="read" value="GW-02-LECT — proposé&#10;Lecture seule, fonctions/adresses utiles&#10;TCP 502 hypothèse H8" style="rounded=1;html=0;whiteSpace=wrap;align=left;spacing=12;verticalAlign=top;fillColor=#fff3df;strokeColor=#38718a;fontColor=#18354c;fontSize=16;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="600" y="520" width="390" height="100" /></mxCell><mxCell id="write" value="GW-02-MAINT — proposé&#10;Lecture puis écritures ciblées autorisées&#10;P_MAINT_02 à confirmer&#10;Fermé hors intervention" style="rounded=1;html=0;whiteSpace=wrap;align=left;spacing=12;verticalAlign=top;fillColor=#fff3df;strokeColor=#38718a;fontColor=#18354c;fontSize=16;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="1180" y="520" width="390" height="130" /></mxCell><mxCell id="reg" value="REG-02 — Modbus TCP 502&#10;Aucune authentification, support terminé&#10;Pas de correctif ni remplacement immédiat" style="rounded=1;html=0;whiteSpace=wrap;align=left;spacing=12;verticalAlign=top;fillColor=#edf6f3;strokeColor=#38718a;fontColor=#18354c;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="600" y="965" width="410" height="95" /></mxCell><mxCell id="field" value="ZF-02 : sonde / porte / groupe&#10;Régulation et avertissement locaux&#10;Comportement de sortie à confirmer" style="rounded=1;html=0;whiteSpace=wrap;align=left;spacing=12;verticalAlign=top;fillColor=#edf6f3;strokeColor=#38718a;fontColor=#18354c;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="1180" y="965" width="390" height="95" /></mxCell><mxCell id="M0" value="" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#245b83;dashed=1;" edge="1" parent="1" source="maint" target="bast"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="M0label" value="Accès contrôlé" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontColor=#18354c;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="245" y="355" width="390" height="55" /></mxCell><mxCell id="Q10" value="" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#245b83;dashed=1;" edge="1" parent="1" source="sup" target="read"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="Q10label" value="Q10 — consultation via GW&#10;Pas de direct SUP → REG-02" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontColor=#18354c;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="795" y="350" width="390" height="55" /></mxCell><mxCell id="Q12" value="" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#245b83;dashed=1;" edge="1" parent="1" source="bast" target="write"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="475" y="545" /><mxPoint x="475" y="780" /><mxPoint x="1375" y="780" /></Array></mxGeometry></mxCell><mxCell id="Q12label" value="Q12 — maintenance bornée&#10;Fermeture / révocation des sessions" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontColor=#18354c;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1080" y="795" width="390" height="55" /></mxCell><mxCell id="U1" value="" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#245b83;dashed=1;" edge="1" parent="1" source="read" target="reg"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="U1label" value="Q11 — GW-02 → REG-02 (TCP 502)" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontColor=#18354c;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1010" y="850" width="390" height="55" /></mxCell><mxCell id="U2" value="" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#245b83;dashed=1;" edge="1" parent="1" source="write" target="reg"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1260" y="845" /><mxPoint x="960" y="845" /></Array></mxGeometry></mxCell><mxCell id="LOCAL" value="" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#245b83;" edge="1" parent="1" source="reg" target="field"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="LOCALlabel" value="Terrain local&#10;Technologie inconnue" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontColor=#18354c;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1030" y="1040" width="390" height="55" /></mxCell><mxCell id="guard" value="IT, STOCK, ORDER, BACKUP, fournisseurs,&#10;MAINT-01, SUP-01 et bastion :&#10;direct vers REG-02 REFUSÉ (Q00).&#10;Pas de pont ou bypass permissif." style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;fontColor=#18354c;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="700" width="430" height="170" /></mxCell><mxCell id="limits" value="GW-02 unique sur le dessin : deux rôles applicatifs, pas deux régulateurs. Son réseau d’administration est à définir.&#10;Panne GW : collecte/maintenance dégradées ; contrôle local attendu si indépendant, à qualifier. Aucun bypass automatique.&#10;Hypothèse d’architecture : aucune règle chargée, capacité de passerelle et résilience non testées." style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;fontColor=#18354c;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="1115" width="1630" height="100" /></mxCell></root></mxGraphModel></diagram></mxfile>