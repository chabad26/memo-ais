        </mxCell>
        <mxCell id="96" value="Bleu : HTTP / Modbus TCP (requêtes-réponses). Gris : données internes.&lt;br&gt;Orange pointillé : commande. Vert épais : effet thermique simulé." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=14;fontColor=#52677d;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="35" y="1423" width="1030" height="42.199999999999996" as="geometry" />
        </mxCell>
        <mxCell id="97" value="Les niveaux 0 et 1 sont regroupés dans le même processus Python. Aucun PLC matériel.&lt;br&gt;Les bandes grisées sont des repères non documentés, sans liaison inventée vers le laboratoire." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=14;fontColor=#52677d;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="35" y="1470" width="1030" height="42.199999999999996" as="geometry" />
        </mxCell>
        <mxCell id="98" value="OpenPLC et FUXA ont été explorés séparément ; aucune connexion au procédé n’est attestée." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=13;fontColor=#52677d;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="35" y="1516" width="1030" height="21.2" as="geometry" />
        </mxCell>
        <mxCell id="99" value="Sources : laboratoire ot-refrigeration-poc ; repérage Purdue : Cisco Industrial Security 3.1, chap. 2." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=11;fontColor=#52677d;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="35" y="1537" width="1030" height="18.4" as="geometry" />
        </mxCell>
