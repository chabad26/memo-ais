        <mxCell id="95" value="LECTURE DU SCHÉMA" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=15;fontColor=#20364d;fontStyle=1;spacing=0;" vertex="1" parent="1">
